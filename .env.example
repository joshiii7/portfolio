# Copy to .env.local for `vercel dev`, and set the same names in the Vercel dashboard
# (Project Settings > Environment Variables). Never commit real values.

# SMTP server used by api/send-mail.js
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sending-address@gmail.com
# Gmail app password (Google account > Security > 2-Step Verification > App passwords)
SMTP_PASS=your-app-password

# Optional, defaults to SMTP_USER
MAIL_FROM=

# reCAPTCHA v2 ("I'm not a robot" checkbox) secret key, from
# google.com/recaptcha/admin. The matching public site key goes in
# src/app/shared/components/contact-form/contact-form.component.ts (RECAPTCHA_SITE_KEY),
# not here — it's meant to be public and ships in the client bundle either way.
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
