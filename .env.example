# Copy to .env.local for `vercel dev`, and set the same names in the Vercel dashboard
# (Project Settings > Environment Variables). Never commit real values.

# SMTP server used by api/send-mail.js
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sending-address@gmail.com
# Gmail app password (Google account > Security > 2-Step Verification > App passwords)
SMTP_PASS=your-app-password

# Optional, defaults to SMTP_USER
MAIL_FROM=
