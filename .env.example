# Copy to .env.local for `vercel dev`, and set the same names in the Vercel dashboard
# (Project Settings > Environment Variables). Never commit real values.

# SMTP server used by api/send-mail.js
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sending-address@gmail.com
# Gmail app password (Google account > Security > 2-Step Verification > App passwords)
SMTP_PASS=your-app-password

# Optional, defaults to SMTP_USER
MAIL_FROM=

# Cloudflare Turnstile secret key, from the Cloudflare dashboard > Turnstile. The matching public
# site key goes in src/environments/environment*.ts (turnstileSiteKey), not here: it is meant to
# be public and ships in the client bundle either way.
# For local testing use Cloudflare's dummy secrets: 1x0000000000000000000000000000000AA always
# passes, 2x0000000000000000000000000000000AA always fails.
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
